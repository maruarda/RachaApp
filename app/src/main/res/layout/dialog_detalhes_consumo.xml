<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_card_rounded"
    android:padding="24dp">

    <!-- Header -->
    <LinearLayout
        android:id="@+id/headerParticipante"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintTop_toTopOf="parent">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/imgAvatarDetalhe"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:src="@drawable/avatar_1"
            android:scaleType="centerCrop"
            app:shapeAppearanceOverlay="@style/CircleImageStyle"
            app:strokeWidth="1dp"
            app:strokeColor="@color/text_secondary"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvNomeParticipanteDetalhe"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:text="Maria"
                android:textColor="@color/text_primary"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Detalhes do consumo"
                android:textColor="@color/text_secondary"
                android:textSize="14sp" />
        </LinearLayout>
    </LinearLayout>

    <View
        android:id="@+id/divider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="16dp"
        android:background="#E0E0E0"
        app:layout_constraintTop_toBottomOf="@id/headerParticipante" />

    <!-- Items List -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvItensDetalhe"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:maxHeight="250dp"
        app:layout_constraintTop_toBottomOf="@id/divider"
        tools:itemCount="3"
        tools:listitem="@layout/item_detalhe_divida" />

    <View
        android:id="@+id/divider2"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="12dp"
        android:background="#E0E0E0"
        app:layout_constraintTop_toBottomOf="@id/rvItensDetalhe" />

    <!-- Total -->
    <LinearLayout
        android:id="@+id/footerTotal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintTop_toBottomOf="@id/divider2">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="sans-serif-medium"
            android:text="Total a Pagar"
            android:textColor="@color/text_primary"
            android:background="@color/bar_background"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvTotalDetalhe"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:text="R$ 60,00"
            android:textColor="@color/text_primary"
            android:textSize="20sp"
            android:background="@color/bar_background"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Confirm Payment Button -->
    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnConfirmarRecebimento"
        android:layout_width="match_parent"
        android:layout_height="45dp"
        android:layout_marginTop="24dp"
        android:background="@drawable/bg_button_rounded"
        android:backgroundTint="#4CAF50"
        android:text="Confirmar Recebimento"
        android:textAllCaps="false"
        android:textColor="@color/white"
        android:textSize="16sp"
        android:textStyle="bold"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/footerTotal" />

    <!-- Close Button -->
    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnFecharDetalhe"
        android:layout_width="match_parent"
        android:layout_height="45dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_button_rounded"
        android:text="Fechar"
        android:textAllCaps="false"
        android:textColor="@color/bar_background"
        android:textSize="16sp"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/btnConfirmarRecebimento" />

</androidx.constraintlayout.widget.ConstraintLayout>