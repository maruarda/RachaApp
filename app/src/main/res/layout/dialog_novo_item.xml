<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="24dp"
    android:background="@drawable/bg_card_rounded">

    <TextView
        android:id="@+id/tvDialogTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Novo Item"
        android:textSize="20sp"
        android:fontFamily="sans-serif-medium"
        android:textColor="@color/text_primary"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <LinearLayout
        android:id="@+id/containerInputs"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/tvDialogTitle">

        <EditText
            android:id="@+id/etNomeItem"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="2"
            android:backgroundTint="@color/text_primary"
            android:hint="Ex: Cerveja"
            android:inputType="textCapSentences"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_secondary"/>

        <Space
            android:layout_width="16dp"
            android:layout_height="wrap_content"/>

        <EditText
            android:id="@+id/etValorItem"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:backgroundTint="@color/text_primary"
            android:hint="R$ 0,00"
            android:inputType="numberDecimal"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_secondary"/>
    </LinearLayout>

    <!-- NEW: Payer Selection -->
    <TextView
        android:id="@+id/lblQuemPagou"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Quem pagou?"
        android:textColor="@color/text_secondary"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/containerInputs"
        app:layout_constraintStart_toStartOf="parent"/>

    <Spinner
        android:id="@+id/spinnerPayer"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginTop="4dp"
        android:background="@drawable/bg_input_rounded"
        app:layout_constraintTop_toBottomOf="@id/lblQuemPagou"/>

    <TextView
        android:id="@+id/lblDividir"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Dividir com:"
        android:layout_marginTop="16dp"
        android:textColor="@color/text_secondary"
        app:layout_constraintTop_toBottomOf="@id/spinnerPayer"
        app:layout_constraintStart_toStartOf="parent"/>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvParticipantesDialog"
        android:layout_width="match_parent"
        android:layout_height="150dp"
        android:layout_marginTop="8dp"
        tools:listitem="@layout/item_amigo_horizontal"
        app:layout_constraintTop_toBottomOf="@id/lblDividir"/>

    <LinearLayout
        android:id="@+id/containerCalculo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="16dp"
        android:padding="12dp"
        android:background="@drawable/bg_card_rounded"
        android:backgroundTint="@color/bar_background"
        app:layout_constraintTop_toBottomOf="@id/rvParticipantesDialog">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Cada um paga:"
            android:textColor="@color/text_secondary"/>

        <Space android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"/>

        <TextView
            android:id="@+id/tvValorPorPessoa"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="R$ 0,00"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"/>
    </LinearLayout>

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnConfirmarDivisao"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:text="Adicionar"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_button_rounded"
        android:textColor="@color/white"
        android:textAllCaps="false"
        app:layout_constraintTop_toBottomOf="@id/containerCalculo"/>

</androidx.constraintlayout.widget.ConstraintLayout>