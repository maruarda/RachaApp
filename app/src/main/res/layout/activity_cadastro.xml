<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bar_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:gravity="center_horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Criar Conta"
            android:textColor="@color/boteco_red"
            android:textSize="28sp"
            android:textStyle="bold"
            android:layout_marginTop="40dp"
            android:layout_marginBottom="24dp"/>

        <!-- SELECTED AVATAR SECTION -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Toque para escolher seu avatar"
            android:textColor="@color/text_secondary"
            android:layout_marginBottom="12dp"/>

        <!-- Main Avatar Button -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardAvatarSelecionado"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:layout_marginBottom="32dp"
            app:cardCornerRadius="60dp"
            app:cardElevation="4dp"
            app:cardBackgroundColor="@color/white">

            <ImageView
                android:id="@+id/imgAvatarDisplay"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/avatar_1"
                android:scaleType="centerCrop"/>

            <!-- Edit Icon Overlay -->
            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="bottom|end"
                android:layout_margin="12dp"
                android:src="@android:drawable/ic_menu_edit"
                app:tint="@color/boteco_red"/>
        </androidx.cardview.widget.CardView>

        <!-- Name -->
        <EditText
            android:id="@+id/etNomeCompleto"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_card_rounded"
            android:backgroundTint="@color/white"
            android:hint="Nome Completo"
            android:paddingStart="20dp"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_secondary"/>

        <!-- Email -->
        <EditText
            android:id="@+id/etEmail"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_card_rounded"
            android:backgroundTint="@color/white"
            android:hint="Email"
            android:inputType="textEmailAddress"
            android:paddingStart="20dp"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_secondary"/>

        <!-- Password -->
        <EditText
            android:id="@+id/etSenha"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_card_rounded"
            android:backgroundTint="@color/white"
            android:hint="Senha"
            android:inputType="textPassword"
            android:paddingStart="20dp"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_secondary"/>

        <!-- Phone -->
        <EditText
            android:id="@+id/etTelefone"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginBottom="40dp"
            android:background="@drawable/bg_card_rounded"
            android:backgroundTint="@color/white"
            android:hint="Telefone"
            android:inputType="phone"
            android:paddingStart="20dp"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_secondary"/>

        <!-- Submit -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnFinalizarCadastro"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:background="@drawable/bg_button_rounded"
            android:backgroundTint="@color/boteco_red"
            android:text="Finalizar Cadastro"
            android:textColor="@color/white"
            android:textStyle="bold"
            android:textSize="18sp"/>

    </LinearLayout>
</ScrollView>