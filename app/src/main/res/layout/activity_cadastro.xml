<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bar_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:gravity="center_horizontal">

        <!-- Título -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Criar Conta"
            android:textColor="@color/boteco_red"
            android:textSize="28sp"
            android:textStyle="bold"
            android:layout_marginTop="40dp"
            android:layout_marginBottom="40dp"/>

        <!-- Instrução -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Escolha seu avatar"
            android:textColor="@color/text_secondary"
            android:layout_marginBottom="16dp"/>

        <!-- LISTA DE AVATARES (Agora com os 7 itens) -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            android:layout_marginBottom="32dp">

            <LinearLayout
                android:id="@+id/containerAvatares"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="4dp">

                <!-- AVATAR 1 -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/cardAvatar1"
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:layout_marginEnd="16dp"
                    app:cardCornerRadius="40dp"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="@android:color/transparent">
                    <ImageView
                        android:id="@+id/imgAvatar1"
                        android:tag="1"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:src="@drawable/avatar_1"
                        android:scaleType="centerCrop"/>
                </androidx.cardview.widget.CardView>

                <!-- AVATAR 2 -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/cardAvatar2"
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:layout_marginEnd="16dp"
                    app:cardCornerRadius="40dp"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="@android:color/transparent">
                    <ImageView
                        android:id="@+id/imgAvatar2"
                        android:tag="2"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:src="@drawable/avatar_2"
                        android:scaleType="centerCrop"/>
                </androidx.cardview.widget.CardView>

                <!-- AVATAR 3 -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/cardAvatar3"
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:layout_marginEnd="16dp"
                    app:cardCornerRadius="40dp"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="@android:color/transparent">
                    <ImageView
                        android:id="@+id/imgAvatar3"
                        android:tag="3"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:src="@drawable/avatar_3"
                        android:scaleType="centerCrop"/>
                </androidx.cardview.widget.CardView>

                <!-- AVATAR 4 -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/cardAvatar4"
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:layout_marginEnd="16dp"
                    app:cardCornerRadius="40dp"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="@android:color/transparent">
                    <ImageView
                        android:id="@+id/imgAvatar4"
                        android:tag="4"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:src="@drawable/avatar_4"
                        android:scaleType="centerCrop"/>
                </androidx.cardview.widget.CardView>

                <!-- AVATAR 5 -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/cardAvatar5"
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:layout_marginEnd="16dp"
                    app:cardCornerRadius="40dp"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="@android:color/transparent">
                    <ImageView
                        android:id="@+id/imgAvatar5"
                        android:tag="5"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:src="@drawable/avatar_5"
                        android:scaleType="centerCrop"/>
                </androidx.cardview.widget.CardView>

                <!-- AVATAR 6 -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/cardAvatar6"
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:layout_marginEnd="16dp"
                    app:cardCornerRadius="40dp"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="@android:color/transparent">
                    <ImageView
                        android:id="@+id/imgAvatar6"
                        android:tag="6"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:src="@drawable/avatar_6"
                        android:scaleType="centerCrop"/>
                </androidx.cardview.widget.CardView>

                <!-- AVATAR 7 -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/cardAvatar7"
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:layout_marginEnd="16dp"
                    app:cardCornerRadius="40dp"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="@android:color/transparent">
                    <ImageView
                        android:id="@+id/imgAvatar7"
                        android:tag="7"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:src="@drawable/avatar_7"
                        android:scaleType="centerCrop"/>
                </androidx.cardview.widget.CardView>

            </LinearLayout>
        </HorizontalScrollView>

        <!-- Campos de Texto -->
        <EditText
            android:id="@+id/etNomeCompleto"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_card_rounded"
            android:backgroundTint="@color/white"
            android:hint="Nome Completo"
            android:paddingStart="20dp"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_secondary"/>

        <EditText
            android:id="@+id/etUsuarioCadastro"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_card_rounded"
            android:backgroundTint="@color/white"
            android:hint="Nome de Usuário"
            android:paddingStart="20dp"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_secondary"/>

        <EditText
            android:id="@+id/etSenhaCadastro"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginBottom="40dp"
            android:background="@drawable/bg_card_rounded"
            android:backgroundTint="@color/white"
            android:hint="Senha"
            android:inputType="textPassword"
            android:paddingStart="20dp"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_secondary"/>

        <!-- Botão Cadastrar -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnFinalizarCadastro"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:background="@drawable/bg_button_rounded"
            android:backgroundTint="@color/boteco_red"
            android:text="Cadastrar"
            android:textColor="@color/white"
            android:textStyle="bold"
            android:textSize="18sp"/>

    </LinearLayout>
</ScrollView>