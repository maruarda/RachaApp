<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:paddingVertical="12dp"
    android:gravity="center_vertical">

    <ImageView
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@drawable/bg_circle_avatar"/>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="12dp"
        android:orientation="vertical">

        <!-- Nome mais escuro e forte -->
        <TextView
            android:id="@+id/tvResumoPessoa"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Maria"
            android:textColor="@color/text_primary"
            android:fontFamily="sans-serif-medium"
            android:textSize="16sp"
            android:textStyle="bold"/>

        <!-- Subtítulo mais escuro (Era cinza claro, agora é Primary/Escuro com transparência) -->
        <TextView
            android:id="@+id/tvResumoRacha"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Referente a: Churrasco"
            android:textColor="#CC4A4A4A"
            android:textSize="13sp"/>
    </LinearLayout>

    <!-- Valor -->
    <TextView
        android:id="@+id/tvResumoValor"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="R$ 30,00"
        android:textColor="@color/text_primary"
        android:fontFamily="sans-serif-medium"
        android:textStyle="bold"
        android:textSize="16sp"/>

</LinearLayout>