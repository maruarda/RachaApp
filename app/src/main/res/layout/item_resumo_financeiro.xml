<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:paddingVertical="12dp"
    android:gravity="center_vertical">

    <!-- CHANGED: Use ShapeableImageView -->
    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/imgResumoAvatar"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:src="@drawable/avatar_1"
        android:scaleType="centerCrop"
        app:shapeAppearanceOverlay="@style/CircleImageStyle"
        app:strokeWidth="1dp"
        app:strokeColor="@color/text_secondary"/>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="12dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvResumoPessoa"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Maria"
            android:textColor="@color/text_primary"
            android:fontFamily="sans-serif-medium"
            android:textSize="16sp"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/tvResumoRacha"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Referente a: Churrasco"
            android:textColor="#CC4A4A4A"
            android:textSize="13sp"/>
    </LinearLayout>

    <TextView
        android:id="@+id/tvResumoValor"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="R$ 30,00"
        android:textColor="@color/text_primary"
        android:fontFamily="sans-serif-medium"
        android:textStyle="bold"
        android:textSize="16sp"/>

</LinearLayout>