<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bar_background"
    android:padding="24dp">

    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Novo Racha"
        android:textColor="@color/boteco_red"
        android:textSize="28sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginTop="24dp"/>

    <EditText
        android:id="@+id/etNomeRacha"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:layout_marginTop="32dp"
        android:background="@drawable/bg_card_rounded"
        android:backgroundTint="@color/white"
        android:hint="Nome do Evento (ex: Churrasco)"
        android:paddingStart="16dp"
        android:textColor="@color/text_primary"
        app:layout_constraintTop_toBottomOf="@id/tvTitle"/>

    <EditText
        android:id="@+id/etLocalRacha"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_card_rounded"
        android:backgroundTint="@color/white"
        android:hint="Local (Opcional)"
        android:paddingStart="16dp"
        android:textColor="@color/text_primary"
        app:layout_constraintTop_toBottomOf="@id/etNomeRacha"/>

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnCriarRachaFinal"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:text="Criar Evento"
        android:textColor="@color/white"
        android:textStyle="bold"
        android:background="@drawable/bg_button_rounded"
        android:backgroundTint="@color/boteco_red"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_marginBottom="24dp"/>

</androidx.constraintlayout.widget.ConstraintLayout>