<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bar_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- ⭐ PERFIL -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp">

            <androidx.cardview.widget.CardView
                android:layout_width="70dp"
                android:layout_height="70dp"
                app:cardCornerRadius="35dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="@android:color/transparent">

                <ImageView
                    android:id="@+id/imgPerfilHome"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/avatar_1"
                    android:scaleType="centerCrop"/>
            </androidx.cardview.widget.CardView>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginStart="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Olá,"
                    android:textColor="@color/text_secondary"
                    android:textSize="16sp"/>

                <TextView
                    android:id="@+id/tvNomeUsuarioHome"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Meu Perfil"
                    android:textColor="@color/text_primary"
                    android:textSize="26sp"
                    android:textStyle="bold"/>
            </LinearLayout>
        </LinearLayout>


        <!-- 🐾 LISTA DE AMIGOS + BOTÃO AO LADO -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- Lista de amigos -->

            <!-- FAB redondinho ao lado -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvAmigosHome"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="horizontal"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                tools:listitem="@layout/item_amigo_horizontal" />

            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/btnAddAmigo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:backgroundTint="@color/boteco_red"
                android:src="@android:drawable/ic_input_add"
                app:tint="@color/white_replacement" />
        </LinearLayout>


        <!-- Subimos as caixas (ANTES estavam com espaço grande abaixo dos amigos) -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card_receber"
            android:padding="20dp"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="12dp">

            <TextView
                android:id="@+id/lblReceber"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="A Receber"
                android:textColor="#15492D"
                android:textSize="20sp"
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvReceber"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                android:layout_marginTop="8dp"
                app:layout_constraintTop_toBottomOf="@id/lblReceber"
                tools:listitem="@layout/item_resumo_financeiro"
                tools:itemCount="2" />

            <View
                android:id="@+id/dividerRec"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#8015492D"
                android:layout_marginTop="12dp"
                app:layout_constraintTop_toBottomOf="@id/rvReceber"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Total:"
                android:textColor="#15492D"
                android:textStyle="bold"
                android:layout_marginTop="12dp"
                app:layout_constraintTop_toBottomOf="@id/dividerRec"
                app:layout_constraintStart_toStartOf="parent"/>

            <TextView
                android:id="@+id/tvTotalReceber"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="R$ 0,00"
                android:textColor="#15492D"
                android:textSize="20sp"
                android:textStyle="bold"
                android:layout_marginTop="12dp"
                app:layout_constraintTop_toBottomOf="@id/dividerRec"
                app:layout_constraintEnd_toEndOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>


        <!-- ⭐ A PAGAR -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card_pagar"
            android:padding="20dp"
            android:layout_marginBottom="20dp">

            <TextView
                android:id="@+id/lblPagar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="A Pagar"
                android:textColor="#B71C1C"
                android:textSize="20sp"
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvPagar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                android:layout_marginTop="8dp"
                app:layout_constraintTop_toBottomOf="@id/lblPagar"
                tools:listitem="@layout/item_resumo_financeiro"
                tools:itemCount="2" />

            <View
                android:id="@+id/dividerPag"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#80B71C1C"
                android:layout_marginTop="12dp"
                app:layout_constraintTop_toBottomOf="@id/rvPagar"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Total:"
                android:textColor="#B71C1C"
                android:textStyle="bold"
                android:layout_marginTop="12dp"
                app:layout_constraintTop_toBottomOf="@id/dividerPag"
                app:layout_constraintStart_toStartOf="parent"/>

            <TextView
                android:id="@+id/tvTotalPagar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="R$ 0,00"
                android:textSize="20sp"
                android:textColor="#B71C1C"
                android:textStyle="bold"
                android:layout_marginTop="12dp"
                app:layout_constraintTop_toBottomOf="@id/dividerPag"
                app:layout_constraintEnd_toEndOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>


        <!-- 🔘 Botões menores e no final -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnMeusRachas"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="Ver Meus Rachas"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:background="@drawable/bg_button_rounded"
            android:layout_marginBottom="12dp" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnCriarNovoRacha"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="+ Criar Novo Racha"
            android:textColor="@color/boteco_red"
            android:textAllCaps="false"
            android:background="@drawable/bg_card_rounded"
            android:backgroundTint="@color/white" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
