<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bar_background"
    android:padding="32dp">

    <!-- Logo Centralizado -->
    <ImageView
        android:id="@+id/imgLogo"
        android:layout_width="200dp"
        android:layout_height="200dp"
        android:src="@drawable/app_logo"
        app:layout_constraintBottom_toTopOf="@+id/btnEntrar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.4" />
    <!-- Use sua imagem aqui. Se não tiver ainda, o Android vai mostrar um erro, mas é só colocar a imagem depois -->

    <!-- Botão Entrar (Abre o Pop-up) -->
    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnEntrar"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_button_rounded"
        android:text="Entrar na Conta"
        android:textAllCaps="false"
        android:textColor="@color/bar_background"
        android:textSize="16sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toTopOf="@+id/btnCriarConta"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Botão Criar Conta (Abre a nova tela) -->
    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnCriarConta"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:layout_marginBottom="48dp"
        android:background="@drawable/bg_button_rounded"
        android:text="Criar Nova Conta"
        android:textAllCaps="false"
        android:textColor="@color/bar_background"
        android:textSize="16sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>